# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
# Keep the npm (SNYK-JS-*) entries identical to the ones in swiyu-trust-management-ui/.snyk: the
# pipeline scans the UI with --file=swiyu-trust-management-ui/package.json and then reads that copy,
# not this one. An entry renewed only here leaves the UI scan on the expired date and breaks the build.
ignore:
